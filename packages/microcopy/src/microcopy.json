        "text": "De waarde moet minimaal {min} zijn.",
        "where": "hlm-field-error",
        "change": "provideHlmFieldErrorMessages({ min: ({ min }) => `…` }), of tekst in hlm-field-error"
      },
      "react": null
    },
    "field.error.max": {
      "component": "Field",
      "kind": "foutmelding",
      "description": "Het getal is te hoog (validator `max`). {max} is de hoogste toegestane waarde.",
