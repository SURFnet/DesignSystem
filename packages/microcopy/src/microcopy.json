{
  "$comment": "Microcopy in Curve's components: every text a component shows or reads out by default. Per framework: `text` is the current default, `where` the component, `change` how an app changes it (null: fixed in the component). Documented in Storybook under Curve > Voor developers > Microcopy. Placeholders like {requiredLength} are filled in from the validator's error.",
  "entries": {
    "field.label.optional": {
      "component": "Field",
      "kind": "zichtbaar",
      "description": "Achter het label van een optioneel veld (`hlmField optional` / `<Field optional>`).",
      "angular": {
        "text": "(optioneel)",
        "where": "hlmFieldLabel",
        "change": "input `optionalText`"
      },
      "react": { "text": "(optioneel)", "where": "FieldLabel", "change": "prop `optionalText`" }
    },
    "field.error.required": {
      "component": "Field",
      "kind": "foutmelding",
      "description": "Een verplicht veld is leeg (validator `required` of `requiredTrue`). Schrijf liever per veld wat er moet: \"Vul een e-mailadres in\".",
      "angular": {
        "text": "Dit veld is verplicht.",
        "where": "hlm-field-error",
        "change": "provideHlmFieldErrorMessages({ required: '…' }), of tekst in hlm-field-error"
      },
      "react": null
    },
    "field.error.email": {
      "component": "Field",
      "kind": "foutmelding",
      "description": "De invoer is geen geldig e-mailadres (validator `email`).",
      "angular": {
        "text": "Vul een geldig e-mailadres in.",
        "where": "hlm-field-error",
        "change": "provideHlmFieldErrorMessages({ email: '…' }), of tekst in hlm-field-error"
      },
      "react": null
    },
    "field.error.minlength": {
      "component": "Field",
      "kind": "foutmelding",
      "description": "De tekst is te kort (validator `minLength`). {requiredLength} is het minimum aantal tekens.",
      "angular": {
        "text": "Vul minimaal {requiredLength} tekens in.",
        "where": "hlm-field-error",
        "change": "provideHlmFieldErrorMessages({ minlength: ({ requiredLength }) => `…` }), of tekst in hlm-field-error"
      },
      "react": null
    },
    "field.error.maxlength": {
      "component": "Field",
      "kind": "foutmelding",
      "description": "De tekst is te lang (validator `maxLength`). {requiredLength} is het maximum aantal tekens.",
      "angular": {
        "text": "Vul maximaal {requiredLength} tekens in.",
        "where": "hlm-field-error",
        "change": "provideHlmFieldErrorMessages({ maxlength: ({ requiredLength }) => `…` }), of tekst in hlm-field-error"
      },
      "react": null
    },
    "field.error.min": {
      "component": "Field",
      "kind": "foutmelding",
      "description": "Het getal is te laag (validator `min`). {min} is de laagste toegestane waarde.",
